{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "security-by-design-contact",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://sergeyshlomov.github.io",
    "MAIL_FROM": "Sergey Shlomov <onboarding@resend.dev>"
  },
  "ratelimits": [{ "name":"CONTACT_RATE_LIMIT", "namespace_id":"1001", "simple": { "limit":5, "period":60 } }]
}
